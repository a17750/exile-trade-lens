<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LibBundle3" HintPath=".cache/runtime/LibBundle3.dll" Private="true" />
    <Reference Include="LibBundledGGPK3" HintPath=".cache/runtime/LibBundledGGPK3.dll" Private="true" />
    <Reference Include="LibGGPK3" HintPath=".cache/runtime/LibGGPK3.dll" Private="true" />
    <Reference Include="SystemExtensions" HintPath=".cache/runtime/SystemExtensions.dll" Private="true" />
    <None Include=".cache/runtime/AnimeStudio.Ooz.dll" Link="AnimeStudio.Ooz.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireBootstrappedDependencies" BeforeTargets="ResolveReferences"
          Condition="!Exists('$(MSBuildProjectDirectory)/.cache/runtime/LibBundledGGPK3.dll')">
    <Error Text="GGPK dependencies are missing. Run tools/ggpk/bootstrap.ps1 first." />
  </Target>
</Project>
