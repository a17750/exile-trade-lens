{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["chrome"],
    "allowJs": false,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "noCheck": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "extension",
    "outDir": "extension"
  },
  "include": ["extension/**/*.ts"],
  "exclude": ["extension/data/**"]
}
